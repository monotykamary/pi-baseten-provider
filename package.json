{
  "name": "pi-baseten-provider",
  "version": "1.0.33",
  "description": "Baseten provider extension for pi - Access DeepSeek, Kimi, GLM, MiniMax, Nemotron, and GPT-OSS models through the Baseten Model API",
  "author": "monotykamary",
  "homepage": "https://github.com/monotykamary/pi-baseten-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-baseten-provider.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/pi-baseten-provider/issues"
  },
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && vitest run && node scripts/test-pi-compat.mjs",
    "test": "vitest run",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "baseten",
    "ai",
    "llm",
    "deepseek",
    "kimi",
    "glm",
    "minimax",
    "nemotron"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "sync-policy.ts",
    "models.json",
    "deprecated-models.json",
    "custom-models.json",
    "patch.json",
    "scripts/update-models.js",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typescript": "6.0.3",
    "@types/node": "^25.9.1",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
